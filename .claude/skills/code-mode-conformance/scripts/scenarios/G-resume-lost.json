{
 "name": "G-resume-lost",
 "env": {"CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1"},
 "commands": {
  "DISPATCH": [{"tools": [{"name": "REPL", "input": {"code": "const r = await Bash({command: 'sleep 60 && echo never', timeout: 200000})\nr.stdout.trim()", "description": "probe"}}]}, {"text": "DONE {{nonce}} dispatched"}],
  "AFTER_OFF": [{"text": "DONE {{nonce}} after-off"}],
  "AFTER_ON": [{"text": "DONE {{nonce}} after-on"}],
  "AFTER_ON:wake": [{"text": "WAKE {{nonce}} lost"}]
 },
 "drive": [
  {"launch": {"mode": "bypassPermissions"}},
  {"send": "DISPATCH"},
  {"wait_req": {"cmd": "DISPATCH", "step": 0, "timeout": 30}},
  {"sleep": 3},
  {"exit": true},
  {"expect_pane": {"name": "session 1: exits while the dispatched eval runs", "match": "EXITED"}},
  {"launch": {"mode": "bypassPermissions", "args": "--resume {{session}}", "env": {"CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": null}}},
  {"turn": "AFTER_OFF"},
  {"expect": {"name": "resume off: reminder names the unsettled eval (official _so)", "cmd": "AFTER_OFF", "step": 0, "field": "messages", "match": "eval #1 never settled: the process that was running it exited\\. Its result is lost and the script is no longer running; a command it had started may have run on\\."}},
  {"exit": true},
  {"launch": {"mode": "bypassPermissions"}},
  {"send": "DISPATCH"},
  {"wait_req": {"cmd": "DISPATCH", "step": 0, "timeout": 30}},
  {"sleep": 3},
  {"exit": true},
  {"launch": {"mode": "bypassPermissions", "args": "--resume {{session}}"}},
  {"sleep": 10},
  {"capture": "resume-on"},
  {"expect": {"name": "resume on (interactive): the lost event starts no turn (official qKa startsTurn false)", "role": "^main:.*:(wake|notif)$", "absent": true}},
  {"turn": "AFTER_ON"},
  {"expect": {"name": "resume on (bypass): lost event for the unsettled eval (official qKa)", "cmd": "AFTER_ON", "step": 0, "field": "messages", "match": "<event nonce=\\\\\"[^\\\\\"]+\\\\\" kind=\\\\\"repl-eval\\\\\"[^>]*eval=\\\\\"1\\\\\" status=\\\\\"lost\\\\\">eval #1 never settled"}},
  {"exit": true}
 ]
}
