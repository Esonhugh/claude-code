{
  "name": "claude-code-desktop",
  "private": true,
  "version": "0.0.0-dev",
  "description": "Desktop app for Claude Code: an Electron window over `claude web --stdio`.",
  "author": "Anthropic <support@anthropic.com>",
  "homepage": "https://github.com/Esonhugh/claude-code",
  "license": "SEE LICENSE IN ../README.md",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "stage": "bun ./stage-sidecar.mjs",
    "dist": "electron-builder --publish never",
    "test": "bun test",
    "e2e": "electron e2e.mjs"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.esonhugh.claude-code",
    "productName": "Claude",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "sidecar.js",
      "theme.js",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": "sidecar"
      }
    ],
    "artifactName": "claude-code-desktop-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Anthropic <support@anthropic.com>"
    }
  }
}
